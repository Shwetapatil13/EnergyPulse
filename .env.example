# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=energypulse
DB_USER=energyuser
DB_PASSWORD=energypass123

# Full SQLAlchemy connection string (overrides individual params if set)
# DATABASE_URL=mysql+pymysql://energyuser:energypass123@localhost:3306/energypulse

# ── Backend ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live

# ── Simulator defaults ────────────────────────────────────
# Speed multiplier: 1 = 1 tick/second (1 min of data), 60 = 1 hr/sec
SIM_DEFAULT_SPEED=1
SIM_DEFAULT_START_DATE=2006-12-16
SIM_LOOP=true

# ── Tariff & Cost ─────────────────────────────────────────
# Default: INR 8 per kWh (assumed flat rate, MSEDCL-like; edit in Settings UI)
DEFAULT_TARIFF_INR_PER_KWH=8.0

# ── ML / Anomaly ─────────────────────────────────────────
# Rolling window size for anomaly detection (minutes)
ANOMALY_WINDOW=60
# Z-score threshold for anomaly alert
ANOMALY_Z_THRESHOLD=3.0
# IQR multiplier
ANOMALY_IQR_MULTIPLIER=1.5
# Absolute threshold for active power (kW) — flag if exceeded
ANOMALY_ABS_THRESHOLD_KW=5.0

# ── Classification thresholds (percentile-based, set after training) ──
# These are overridden at runtime after computing from training data
CLASS_LOW_THRESHOLD=0.33
CLASS_HIGH_THRESHOLD=0.67
